# Shared by every RDS variant. Variant fragments add only what differs.
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_NEON=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_REPRODUCIBLE=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_DL_DIR="/w/dl"
BR2_BACKUP_SITE=""
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_RDS_PATH)/patches"
BR2_TARGET_GENERIC_HOSTNAME="rds"
BR2_TARGET_GENERIC_ISSUE="RDS control board"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.53"
# The toolchain's kernel headers are the kernel's own; the series must match
# the version above (checked by env/stages.d/build/15-config-gate.sh).
BR2_KERNEL_HEADERS_AS_KERNEL=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_LINUX_KERNEL_ZIMAGE=y
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set
