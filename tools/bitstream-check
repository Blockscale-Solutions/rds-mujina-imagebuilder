#!/usr/bin/env python3
"""Is this the FPGA bitstream we know? By hash and size, never by name (#23).

    tools/bitstream-check [--allowlist FILE] BITSTREAM

Exit 0 known (prints the revision), 1 unknown, 2 when the allowlist has no
rows: a check against nothing has measured nothing.
"""
import argparse, hashlib, os, sys

HERE = os.path.dirname(os.path.abspath(__file__))
ap = argparse.ArgumentParser()
ap.add_argument("--allowlist", default=os.path.join(os.path.dirname(HERE), "data/allowlist/bitstream.tsv"))
ap.add_argument("bitstream")
a = ap.parse_args()
rows = [l.rstrip("\n").split("\t") for l in open(a.allowlist) if l.strip() and not l.startswith("#")]
if not rows:
    print("bitstream-check: empty allowlist: unmeasured"); sys.exit(2)
data = open(a.bitstream, "rb").read()
h, n = hashlib.sha256(data).hexdigest(), len(data)
for r in rows:
    if r[0] == h and int(r[1]) == n:
        print(f"known {r[2]} ({h}, {n} B)"); sys.exit(0)
print(f"unknown bitstream {h} ({n} B): not in {a.allowlist}")
sys.exit(1)
