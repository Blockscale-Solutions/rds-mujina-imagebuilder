#!/usr/bin/env python3
"""FPGA blocks from hw.toml into the device tree, and the checks (#42).

    tools/hw2dts check [HW.toml]         provenance and its shape, overlaps, measured IRQs
    tools/hw2dts dtsi [HW.toml]          the generated include, on stdout
    tools/hw2dts check-dts FILE...       no gpio-hog anywhere (PSU enable is never hogged)
    tools/hw2dts verify-dtb DTS [HW.toml]  a decompiled DTB carries every block exactly
"""
import os, re, sys, tomllib

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT = os.path.join(os.path.dirname(HERE), "os/board/rds-control/hw.toml")
TRIG = {"level-high": "IRQ_TYPE_LEVEL_HIGH", "edge-rising": "IRQ_TYPE_EDGE_RISING", "edge-falling": "IRQ_TYPE_EDGE_FALLING"}
# The GIC binding's flag values, to compare a booted tree's raw interrupts cell.
TRIG_FLAG = {"edge-rising": 1, "edge-falling": 2, "level-high": 4}


def dt_irq(n, b):
    """dt_interrupts = "<type> <number> <flags>" as the booted tree gives it (GIC SPI = 0)."""
    try:
        t, num, flags = (int(x, 0) for x in str(b["dt_interrupts"]).split())
    except ValueError:
        return [f"{n}: dt_interrupts must be three numbers, got {b['dt_interrupts']!r}"]
    errs = []
    if t != 0 or num != b["spi"]:
        errs.append(f"{n}: spi {b['spi']} disagrees with the booted tree's interrupts {b['dt_interrupts']}")
    if flags != TRIG_FLAG.get(b.get("trigger")):
        errs.append(f"{n}: trigger {b.get('trigger')} disagrees with the booted tree's flags {flags}")
    return errs
# Provenance tags (DESIGN.md). The vendor-derived tag is assembled, so this file
# never carries the marker tools/publish-seed refuses.
VD = "VENDOR" + "-DERIVED"
TAGS = ("MEASURED", "DERIVED", "INFERRED", "PUBLIC", "OURS", VD)


def provenance(name, field, src):
    """A source starts with a known tag; MEASURED names its capture, and a
    vendor-derived fact names the measurement that will replace it (#104)."""
    tag = str(src).split(":", 1)[0].strip()
    if tag not in TAGS:
        return [f"{name}: {field} has no known tag ({', '.join(TAGS)})"]
    if tag == "MEASURED" and "u:" not in src:
        return [f"{name}: {field} is MEASURED but names no capture (u:...)"]
    if tag == VD and "pending" not in src:
        return [f"{name}: {field} is vendor-derived but names no pending measurement"]
    return []


def load(p):
    with open(p, "rb") as f:
        return tomllib.load(f).get("block", [])


def check(blocks):
    errs = []
    if not blocks:
        return ["no blocks: unmeasured"]
    for b in blocks:
        n = b.get("name", "?")
        if not b.get("reg_source"):
            errs.append(f"{n}: base and size have no reg_source")
        for field in ("reg_source", "irq_source"):
            if b.get(field):
                errs += provenance(n, field, b[field])
        if "spi" in b:
            if not b.get("irq_source"):
                errs.append(f"{n}: interrupt has no irq_source")
            if b.get("trigger") not in TRIG:
                errs.append(f"{n}: unknown trigger {b.get('trigger')}")
            if str(b.get("irq_source", "")).startswith("MEASURED"):
                # A measured interrupt is checked against what measured it: the stock
                # /proc/interrupts hwirq, or the booted device tree's raw interrupts
                # value (a chained line, e.g. a PIO's, never shows in /proc/interrupts).
                if "stock_hwirq" in b:
                    if b["stock_hwirq"] != b["spi"] + 32:
                        errs.append(f"{n}: spi {b['spi']} disagrees with the measured stock hwirq {b.get('stock_hwirq')} (hwirq = spi + 32)")
                elif "dt_interrupts" in b:
                    errs += dt_irq(n, b)
                else:
                    errs.append(f"{n}: a MEASURED interrupt needs stock_hwirq or dt_interrupts (the booted device tree)")
        if b.get("access") not in ("uio", "mainline", "none"):
            errs.append(f"{n}: access must be uio, mainline or none")
        if b.get("access") == "mainline" and not b.get("compatible"):
            errs.append(f"{n}: a mainline block needs its compatible")
    s = sorted(blocks, key=lambda b: b["base"])
    for a, b in zip(s, s[1:]):
        if a["base"] + a["size"] > b["base"]:
            errs.append(f"{a['name']} and {b['name']} overlap")
    return errs


def dtsi(blocks):
    L = ["// SPDX-License-Identifier: GPL-2.0-or-later",   # the repository's licence (LICENSE)
         "/* GENERATED by tools/hw2dts from os/board/rds-control/hw.toml. Do not edit. */",
         "#include <dt-bindings/interrupt-controller/arm-gic.h>", "#include <dt-bindings/interrupt-controller/irq.h>",
         "", "&{/soc} {"]
    for b in sorted(blocks, key=lambda b: b["base"]):
        if b["access"] == "none":
            continue
        n, a = b["name"], b["base"]
        L.append(f"\t{n}@{a:x} {{")
        L.append(f'\t\tcompatible = "{"generic-uio" if b["access"] == "uio" else b["compatible"]}";')
        L.append(f"\t\treg = <0x{a:08x} 0x{b['size']:x}>;")
        if "spi" in b:
            L.append(f"\t\tinterrupts = <GIC_SPI {b['spi']} {TRIG[b['trigger']]}>;")
        if b["access"] == "uio":
            L.append(f'\t\tlinux,uio-name = "{n}";')
        if b["kind"] == "gpio":
            L += ["\t\taltr,ngpio = <32>;", "\t\t#gpio-cells = <2>;", "\t\tgpio-controller;"]
            if "spi" in b:
                L += ["\t\taltr,interrupt-type = <IRQ_TYPE_EDGE_RISING>;", "\t\t#interrupt-cells = <2>;", "\t\tinterrupt-controller;"]
        if b["kind"] == "i2c":
            L += ["\t\t#address-cells = <1>;", "\t\t#size-cells = <0>;", "\t\tfifo-size = <4>;", "\t\tclock-frequency = <100000>;"]
        L.append("\t};")
    L.append("};")
    return "\n".join(L) + "\n"


def verify_dtb(text, blocks):
    """Every non-reserved block appears with its exact reg and interrupt."""
    code = {"level-high": 4, "edge-rising": 1, "edge-falling": 2}
    errs = []
    for b in blocks:
        if b["access"] == "none":
            continue
        m = re.search(r"\b" + re.escape(f"{b['name']}@{b['base']:x}") + r"\s*\{(.*?)\n\s*\};", text, re.S)
        if not m:
            errs.append(f"{b['name']}: node missing from the DTB"); continue
        body = m.group(1)
        cells = lambda k: [int(x, 16) for x in re.search(k + r"\s*=\s*<([^>]*)>", body).group(1).split()] if re.search(k + r"\s*=", body) else None
        if cells("reg") != [b["base"], b["size"]]:
            errs.append(f"{b['name']}: reg {cells('reg')} differs from hw.toml")
        want = [0, b["spi"], code[b["trigger"]]] if "spi" in b else None
        if cells("interrupts") != want:
            errs.append(f"{b['name']}: interrupts {cells('interrupts')} differ from hw.toml {want}")
    return errs


def main():
    if len(sys.argv) < 2:
        print(__doc__); sys.exit(64)
    cmd = sys.argv[1]
    if cmd == "check-dts":
        bad = [f for f in sys.argv[2:] if re.search(r"\bgpio-hog\b", open(f).read())]
        for f in bad:
            print(f"FAIL {f}: contains a gpio-hog; no line may be forced (the PSU enable must never be)")
        sys.exit(1 if bad else 0)
    if cmd == "verify-dtb":
        blocks = load(sys.argv[3] if len(sys.argv) > 3 else DEFAULT)
        errs = verify_dtb(open(sys.argv[2]).read(), blocks)
        for e in errs:
            print("FAIL " + e)
        print(f"hw2dts: DTB checked against {len(blocks)} blocks, {len(errs)} problem(s)")
        sys.exit(1 if errs else 0)
    blocks = load(sys.argv[2] if len(sys.argv) > 2 else DEFAULT)
    errs = check(blocks)
    if cmd == "check":
        for e in errs:
            print("FAIL " + e)
        print(f"hw2dts: {len(blocks)} blocks, {len(errs)} problem(s)")
        sys.exit(1 if errs else 0)
    if errs:
        for e in errs:
            print("FAIL " + e, file=sys.stderr)
        sys.exit(1)
    sys.stdout.write(dtsi(blocks))


if __name__ == "__main__":
    main()
