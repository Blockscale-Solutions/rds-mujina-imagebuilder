#!/usr/bin/env python3
"""Size budget gate: images against their UBI volumes (#21, gate C8).

    tools/budget [--layout FILE] LAYOUT VOLUME=IMAGE ...

Volume sizes come from layout.toml through tools/layout, never from here.
Prints each image's fill and headroom. Exit 0 when every image fits, 1 when
any is over or names a volume the layout lacks, 2 when no image was given.
"""
import argparse, importlib.machinery, importlib.util, os, sys, tomllib

HERE = os.path.dirname(os.path.abspath(__file__))
loader = importlib.machinery.SourceFileLoader("layout", os.path.join(HERE, "layout"))
spec = importlib.util.spec_from_loader("layout", loader)
layout = importlib.util.module_from_spec(spec); loader.exec_module(layout)

ap = argparse.ArgumentParser()
ap.add_argument("--layout", default=layout.DEFAULT)
ap.add_argument("name")
ap.add_argument("images", nargs="*")
a = ap.parse_args()
if not a.images:
    print("budget: no images given: unmeasured"); sys.exit(2)
with open(a.layout, "rb") as f:
    cfg = tomllib.load(f)
leb = cfg["device"]["leb_bytes"]
vols = {v["name"]: v["lebs"] * leb for v in layout.resolve(cfg, a.name)}
bad = 0
for pair in a.images:
    vol, _, path = pair.partition("=")
    size = os.path.getsize(path)
    if vol not in vols:
        print(f"FAIL {vol}: no such volume in layout {a.name}"); bad += 1; continue
    cap = vols[vol]
    head = (cap - size) / cap * 100
    if size > cap:
        print(f"OVER {vol} {size} of {cap} B, {size - cap} B over"); bad += 1
    else:
        print(f"{vol} {size} of {cap} B, headroom {head:.1f}%")
sys.exit(1 if bad else 0)
